{
  "name": "dakka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --build --force",
    "build": "pnpm --filter @dakka/web build",
    "test": "vitest run",
    "harness": "pnpm --filter @dakka/harness harness",
    "harness:profile": "pnpm --filter @dakka/harness run harness:profile",
    "profile:client": "pnpm --filter @dakka/harness run profile:client",
    "dominance": "pnpm --filter @dakka/harness run dominance",
    "causes": "pnpm --filter @dakka/harness run causes",
    "prompt-size": "pnpm --filter @dakka/harness run prompt-size",
    "db:seed": "pnpm --filter @dakka/db run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
