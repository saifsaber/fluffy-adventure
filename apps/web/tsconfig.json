      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/content"
    },
    {
      "path": "../../packages/ai"
    },
    {
      "path": "../../packages/fixture"
    },
    {
      "path": "../../packages/board"
    },
    {
      "path": "../../packages/season"
    },
    {
      "path": "../../packages/dashboard"
    }
  ]
